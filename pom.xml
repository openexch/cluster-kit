<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.openexchange</groupId>
    <artifactId>cluster-kit</artifactId>
    <version>0.1.8-runtime.20260928.r02c.g49fcc04</version>
    <packaging>jar</packaging>

    <name>Cluster Kit</name>
    <description>Engine-agnostic Aeron cluster infrastructure shared by the matching engine and the assets engine</description>
    <url>https://github.com/openexch/cluster-kit</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Compiled against the LOWEST version any consumer runs, so the
             bytecode is valid on all of them. `provided` scope: each engine
             supplies and shades its own copy; this pin only sets the compile
             floor. Raise it only when the slowest consumer has moved. The
             floor moved to 1.52.2/2.5.0 on 2026-08-10 (assets #44 aligned the
             two clusters on one substrate; match and oms were already there),
             so this now matches all three consumers. -->
        <aeron.version>1.53.0</aeron.version>
        <agrona.version>2.6.0</agrona.version>
        <junit.version>4.13.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-all</artifactId>
            <version>${aeron.version}</version>
            <!-- provided: the engines bring their own Aeron and shade it. This
                 artifact must never pull a second copy into their uber jars. -->
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
            <version>${agrona.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/openexch/cluster-kit</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- Agrona reaches jdk.internal.misc.Unsafe for every buffer it
                         touches, so any test that builds a real Aeron counter needs
                         these opens. The engines already pass them at runtime (and in
                         their own surefire config); without them here a counter-backed
                         test fails with NoClassDefFoundError on org.agrona.BufferUtil,
                         which reads as a broken test rather than a missing flag. -->
                    <argLine>
                        --add-opens java.base/jdk.internal.misc=ALL-UNNAMED
                        --add-opens java.base/java.nio=ALL-UNNAMED
                        --add-opens java.base/sun.nio.ch=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

<!-- Maven settings for CI: GitHub Packages auth via the workflow token.
     Local development does not need this file — `mvn install` in this repo puts
     the artifact in the local ~/.m2 where both engines will find it. -->
<settings>
  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>
</settings>
